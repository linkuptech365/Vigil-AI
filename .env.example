# Vigil-AI 环境变量模板：复制为 .env 后按需修改

# 网关监听端口（Docker 镜像内固定为 3000）
PORT=3000

# 允许 scan-folder / extract-frames 访问的物理目录白名单，Linux 以 ":" 分隔
# 项目目录与系统临时目录始终允许，此处用于追加授权目录
VIGIL_ALLOWED_ROOTS=/data/videos:/tmp:/tmp/vigil-test

# 默认二级研判模型标识
NEXT_PUBLIC_DEFAULT_VLM_MODEL=qwen2.5-vl-72b

# VLM 推理网关地址与密钥（密钥请勿提交到仓库）
VLM_API_URL=http://localhost:8000/api/v1/analyze
VLM_API_KEY=
