# Vigil-AI environment template. Copy to `.env` and adjust as needed.
# Vigil-AI 环境变量模板：复制为 .env 后按需修改。
#
# Every value below is the built-in default unless noted, so an empty .env is valid.
# 下列取值均为内置默认值（另有说明除外），空 .env 同样可以运行。
#
# Tier-2 VLM credentials (OpenAI / Azure OpenAI / Qwen / any OpenAI-compatible gateway)
# are NOT read from the environment. Add them in the console under
# "Model Gateway" (配置中心 > 模型网关); they are stored server-side in data/models.json
# (file mode 600) and only masked values are ever returned by the API.
# 二级大模型密钥不从环境变量读取，请在控制台「模型网关」中配置，仅保存在服务端 data/models.json。

# ---------------------------------------------------------------------------
# Gateway (Next.js) / 网关
# ---------------------------------------------------------------------------

# Gateway listen port (fixed to 3000 inside the Docker image).
# 网关监听端口（Docker 镜像内固定为 3000）。
PORT=3000

# Persistent data directory: rules.json, streams.json, models.json, stream-alerts.json,
# stream-evidence/, go2rtc.yaml ... (mounted as the `vigil_data` volume in Docker: /app/data).
# 持久化目录（规则库、视频流、模型网关、告警与证据等）。
# VIGIL_DATA_DIR=./data

# Directory allow-list for scan-folder / extract-frames, ":" separated on Linux (";" on Windows).
# The project directory and the system temp directory are always allowed.
# 物理目录白名单，Linux 以 ":" 分隔；项目目录与系统临时目录始终允许。
VIGIL_ALLOWED_ROOTS=/data/videos:/tmp:/tmp/vigil-test

# Optional: extra root used when an API receives a bare file name / relative path.
# Automatically added to the allow-list.
# 可选：按文件名寻址视频时额外查找的目录，自动加入白名单。
# VIGIL_SCAN_DIR=/data/videos

# Optional: video used by the built-in demo loop stream (cleanroom_demo_loop).
# 可选：内置模拟循环流使用的视频文件。
# VIGIL_DEMO_VIDEO=/data/videos/demo.mp4

# Evidence retention in days (frames + manifest.json under stream-evidence/).
# 证据保留天数。
VIGIL_EVIDENCE_RETENTION_DAYS=365

# Bearer token shared by the gateway and the vision worker for edge -> gateway callbacks
# (/api/v1/incident/trigger, /api/v1/hits/ingest, /api/v1/audit/ingest).
# Empty means "no authentication": set a long random value in production,
# e.g. `openssl rand -hex 32`.
# 边缘送审回调的 Bearer 凭证，视觉服务与网关共用；为空表示不鉴权，生产环境务必设置。
# VIGIL_EDGE_TOKEN=

# URL the vision worker uses to call the gateway back. Default: http://127.0.0.1:<PORT>
# 视觉服务回调网关的地址，默认 http://127.0.0.1:<PORT>。
# VIGIL_INTERNAL_URL=http://127.0.0.1:3000

# Global hard switch for server-side auto patrol (default OFF). When not "true",
# no patrol timer is created and no background VLM tokens are consumed.
# 服务端自动巡检全局硬开关（默认关闭），未设为 true 时不会产生后台 Token 消耗。
# ENABLE_STREAM_PATROL=false

# ---------------------------------------------------------------------------
# Streaming gateway (go2rtc, embedded) / 内嵌流媒体网关
# ---------------------------------------------------------------------------

# Set to 1 to disable the embedded go2rtc process.
# 设为 1 关闭内置 go2rtc。
# VIGIL_DISABLE_STREAM_ENGINE=1

# Use an existing go2rtc binary / change the directory `pnpm setup:engine` installs into.
# 指定已有 go2rtc 二进制，或修改 `pnpm setup:engine` 的安装目录。
# GO2RTC_BIN=
# VIGIL_BIN_DIR=./bin

# Offline / mirrored installs for `pnpm setup:engine`.
# 离线或镜像安装。
# GO2RTC_SKIP_DOWNLOAD=1
# GO2RTC_DOWNLOAD_BASE=https://github.com/AlexxIT/go2rtc/releases/latest/download

# Path of the ffmpeg binary (the Docker image sets /usr/bin/ffmpeg; otherwise ffmpeg-static is used).
# ffmpeg 路径（Docker 镜像内为 /usr/bin/ffmpeg，否则使用 ffmpeg-static）。
# FFMPEG_PATH=

# ---------------------------------------------------------------------------
# Tier-1 vision worker (Python) / 一级视觉 Worker
# The worker only listens on 127.0.0.1 and is proxied by the gateway.
# Worker 仅监听 127.0.0.1，由网关统一代理。
# ---------------------------------------------------------------------------

# Set to 1 to disable the Python worker and fall back to the Node-side frame-difference pre-filter.
# 设为 1 关闭 Python Worker，仅保留 Node 端帧差预筛。
# VIGIL_DISABLE_VISION_ENGINE=1

# Worker port.
# Worker 端口。
VIGIL_VISION_PORT=1985

# Directory containing the YOLO-World weights (yolov8s-worldv2.pt). Default: <project>/models
# YOLO-World 权重目录，默认 <项目>/models。
# VIGIL_MODELS_DIR=./models

# --- Gate 0: confidence floors / 置信度门槛 ---------------------------------

# Floor for open-vocabulary prompts (subject / context / hazard). YOLO-World scores are
# systematically lower than closed-set detectors, so these prompts use
# min(global_low, VIGIL_OPEN_VOCAB_CONF) instead of the global threshold. Range 0.05 ~ 0.95.
# 开放词汇词条的置信度底线，范围 0.05 ~ 0.95。
VIGIL_OPEN_VOCAB_CONF=0.30

# Weak-prior floor for ROLE_CONTEXT objects (feeder, bowl, litter box ...). Once the subject has
# passed its own threshold, context objects only need this value to take part in spatial
# relation checks, so a low-scored object no longer blocks the subject. Range 0.05 ~ 0.30.
# 关联客体弱先验阈值：主体通过自身门槛后，客体只需达到该值即可参与空间关系判定。
VIGIL_CONTEXT_WEAK_CONF=0.10

# Rescue pass: when no prompt passes in a frame, re-run once at higher resolution with the
# subject/context floors relaxed to this value. 0 disables the rescue pass. Range 0 ~ 0.5.
# 补救重推理的放宽门槛，0 关闭。
VIGIL_RESCUE_CONF=0.15

# Diagnostic floor: candidates between this value and the gate threshold are listed in the
# "raw model output" trace but never take part in gating. Range 0.01 ~ 0.25.
# 诊断用底线：低于门槛的候选只进入原始输出追踪，不参与门禁。
VIGIL_RAW_DIAG_FLOOR=0.05

# Mean luma below which low-light enhancement is applied before inference.
# 平均亮度低于该值时对画面做低照度增强。
VIGIL_LOW_LIGHT_LUMA=80

# --- Subject coasting (single-frame miss recovery) / 主体滑动保持 -----------

# A non-person subject (cat, dog ...) that disappears keeps its last valid box while it has been
# missing for less than COAST_SECONDS *or* fewer than COAST_FRAMES inferences. Anything older
# than COAST_HARD_SECONDS is always dropped.
# 非人员主体漏检时沿用上一次有效框：漏检时长 < COAST_SECONDS 或漏检次数 < COAST_FRAMES；
# 超过 COAST_HARD_SECONDS 一律丢弃。
VIGIL_COAST_SECONDS=1.5
VIGIL_COAST_FRAMES=3
VIGIL_COAST_HARD_SECONDS=6.0

# --- De-duplication & cooldown / 去重与冷却 ---------------------------------

# Same-signature hits inside this window (seconds) are folded into one hit-history entry.
# 命中记录去重窗口（秒）：窗口内同签名命中折叠为一条。
VIGIL_HIT_DEDUPE_SECONDS=8

# Upper bound (seconds) for the cooldown of smoking-type rules. 0 disables the cap.
# 吸烟类规则冷却上限（秒），0 表示不设上限。
VIGIL_SMOKING_COOLDOWN_CAP=30

# --- Throughput / 吞吐 ------------------------------------------------------

# Total inference FPS budget shared by all channels on CPU-only hosts.
# CPU 主机上所有通道共享的总推理帧率上限。
VIGIL_CPU_MAX_FPS=3

# PyTorch intra-op threads. 0 = auto (CPU cores - 1).
# PyTorch 线程数，0 为自动（核数 - 1）。
# VIGIL_TORCH_THREADS=0

# ---------------------------------------------------------------------------
# Python runtime provisioning (`pnpm setup:vision`) / Python 运行环境安装
# ---------------------------------------------------------------------------

# Use a specific Python interpreter / environment home.
# 指定 Python 解释器或运行环境主目录。
# VIGIL_PYTHON=
# VIGIL_PYTHON_HOME=

# Installer switches (equivalent to the CLI flags --cpu / --gpu / --light / --uv / --skip-weights).
# 安装开关，等价于命令行参数。
# VIGIL_VISION_CPU=1
# VIGIL_VISION_GPU=1
# VIGIL_VISION_LIGHT=1
# VIGIL_USE_UV=1
# VIGIL_VISION_SKIP_WEIGHTS=1
# VIGIL_UV_DOWNLOAD_BASE=https://github.com/astral-sh/uv/releases/latest/download

# Set to 1 when the Python environment is baked into the image (Docker does this for you).
# Prevents the console from triggering a runtime install.
# 视觉环境已固化进镜像时设为 1（Docker 镜像已设置），禁止控制台触发运行时安装。
# VIGIL_PREBAKED_VISION=1

# ---------------------------------------------------------------------------
# Alert linkage channels (optional) / 联动渠道（可选）
# ---------------------------------------------------------------------------
# VIGIL_LINKAGE_WEBHOOK_URL=
# VIGIL_LINKAGE_IM_URL=
# VIGIL_LINKAGE_SIREN_URL=
# VIGIL_LINKAGE_IOT_URL=
